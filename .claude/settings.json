{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING": "true",
    "CLAUDE_CODE_EFFORT_LEVEL": "high",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "true"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Skill",
      "Bash(bun run typecheck*)",
      "Bash(bun run tsc*)",
      "Bash(bun run lint*)",
      "Bash(bun run format*)",
      "Bash(bun run fmt*)",
      "Bash(bunx tsc*)",
      "Bash(bunx eslint*)",
      "Bash(bunx prettier*)",
      "Bash(bunx biome*)",
      "Bash(pnpm run typecheck*)",
      "Bash(pnpm run tsc*)",
      "Bash(pnpm run lint*)",
      "Bash(pnpm run format*)",
      "Bash(pnpm run fmt*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm exec biome*)",
      "Read",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(fd:*)",
      "Bash(find:*)",
      "mcp__plugin_*",
      "Bash(wc:*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git tag*)",
      "Bash(git stash list*)",
      "Bash(git remote -v*)",
      "Bash(git blame*)",
      "Bash(git shortlog*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-files*)",
      "Bash(git ls-remote*)",
      "Bash(git describe*)",
      "Bash(git config --get*)",
      "Bash(git config --list*)",
      "Bash(gh label:*)",
      "Bash(gh milestone:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet[1m]",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Applications/Muxy.app/Contents/Resources/Muxy_Muxy.bundle/muxy-claude-hook.sh' notification # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "'/Applications/Muxy.app/Contents/Resources/Muxy_Muxy.bundle/muxy-claude-hook.sh' stop # muxy-notification-hook",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/hooks/statusline"
  },
  "enabledPlugins": {
    "agent-sdk-dev@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true,
    "codex@openai-codex": true,
    "context7@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true,
    "greptile@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "vercel@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "syntaxHighlightingDisabled": false,
  "effortLevel": "high",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
