font-family = "JetBrainsMono Nerd Font"
font-size = 20
theme = Vague
shell-integration-features = no-cursor,sudo,no-title
background-opacity = 0.93
# background-opacity = 1
background-blur = 100

unfocused-split-opacity = 1

window-padding-balance = true 
window-save-state = always
macos-titlebar-style = hidden
# macos-titlebar-style = tabs #transparent, tabs, native, hidden
# window-decoration = none
# macos-window-shadow = false
window-colorspace = "display-p3"
confirm-close-surface = true
background=#141415
# background=#14161b
# background = #1E1E1E
# background = #000000
# background = #242424

# Clipboard
copy-on-select = clipboard
clipboard-write = allow
clipboard-read = allow

# Keybinds
keybind = alt+backspace=text:\x1b\x7f
# keybind = shift+enter=text:\x1b\r

# Pass Cmd+1..9 through to terminal as Meta+1..9, so tmux can use them
# for direct window selection. These override Ghostty's default macOS tab
# shortcuts, which use digit_1..digit_8.
# keybind = cmd+digit_1=text:\x1b1
# keybind = cmd+digit_2=text:\x1b2
# keybind = cmd+digit_3=text:\x1b3
# keybind = cmd+digit_4=text:\x1b4
# keybind = cmd+digit_5=text:\x1b5
# keybind = cmd+digit_6=text:\x1b6
# keybind = cmd+digit_7=text:\x1b7
# keybind = cmd+digit_8=text:\x1b8
